# ===== DISCORD =====
DISCORD_TOKEN=coloque_o_token_do_bot_aqui
CLIENT_ID=id_da_aplicacao_do_bot
GUILD_ID=id_do_servidor

# Cargo de STAFF que pode ver e mexer nos tickets (ex: recrutadores/lideranca)
STAFF_ROLE_ID=id_do_cargo_staff

# Cargo dado automaticamente ao ser aprovado (ex: Shinpei)
APPROVED_ROLE_ID=id_do_cargo_aprovado

# Categoria onde os canais de ticket serao criados
TICKET_CATEGORY_ID=id_da_categoria

# Opcional: categoria separada para as salas de partida da Arena.
# Se nao definir, usa a mesma TICKET_CATEGORY_ID acima.
ARENA_CATEGORY_ID=

# Opcional: canal publico onde o bot avisa quando alguem entra na fila
# ou quando uma partida e encontrada.
ARENA_CHANNEL_ID=

# Canal que recebe o resultado/historico das partidas da Arena (diferente do LOG_CHANNEL_ID do recrutamento!)
ARENA_LOG_CHANNEL_ID=

# Canal onde o bot manda o resumo/transcript de cada recrutamento (opcional, mas recomendado)
LOG_CHANNEL_ID=id_do_canal_de_logs

# ===== SUPABASE =====
SUPABASE_URL=https://njenygwuqcjfkzeazade.supabase.co
# Use a service_role key (Settings > API no painel do Supabase). NUNCA exponha essa chave publicamente.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui
